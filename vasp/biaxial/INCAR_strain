SYSTEM = HfO2 Pca2_1  biaxial strain : constrained cell relaxation

!=====================================================================
! 1단계. biaxial 변형을 건 뒤 "변형 축은 고정, 나머지 축과 이온만 완화"
!
! POSCAR 에 이미 (1+eps) 를 곱해 둔 상태로 들어온다.
! 여기서는 그 축을 붙잡아 두고 나머지 축 길이와 내부 좌표만 내린다.
!=====================================================================

!---- 축 고정 -------------------------------------------------------
! LATTICE_CONSTRAINTS : 격자벡터 a1 a2 a3 각각을 "변하게 둘 것인가"
!   .TRUE.  = 그 격자벡터를 **완화시킨다** (자유)
!   .FALSE. = 그 격자벡터를 **고정한다**
!   기본값 .TRUE. .TRUE. .TRUE. (= 보통의 ISIF=3)
!   VASP 6.x 전용. ISIF >= 3 과 함께 써야 의미가 있다.
!
! >>> 아래 줄은 요청하신 값 그대로다. 의미는 "a1,a3 자유 / a2 고정" 이다. <<<
LATTICE_CONSTRAINTS = .TRUE. .FALSE. .TRUE.
!
! !! 확인 요망 !!
!   이 프로젝트의 biaxial 은 "거울축 둘을 변형해 고정하고 편극축을 자유 relax"
!   이다 (results/weyl_trend/SUMMARY.md 의 '편극축(자유) 실측' 열).
!   source/m1_mirror, p1_mirror, pristine_mirror 는 편극축이 a2 이므로
!   그 의도대로라면 아래가 맞다:
!       LATTICE_CONSTRAINTS = .FALSE. .TRUE. .FALSE.
!   source/m2.5_mirror, m3_mirror, parent_pristine 은 편극축이 a3 이므로:
!       LATTICE_CONSTRAINTS = .FALSE. .FALSE. .TRUE.
!   make_biaxial_vasp.py 가 spglib 으로 편극축을 찾아 이 줄을 자동으로 맞춰
!   써 준다. 수동으로 쓸 때만 위를 확인할 것.

!---- 완화 ----------------------------------------------------------
IBRION =   2        ! 공액구배. 셀+이온 동시 완화에 가장 안정적
ISIF   =   3        ! 이온 + 셀 모양 + 부피 (LATTICE_CONSTRAINTS 가 제한)
NSW    = 300        ! 이온 단계 상한
POTIM  = 0.30       ! 첫 시도 스텝. 발산하면 0.1 로 낮출 것
EDIFFG = -1E-3      ! 힘 수렴 1 meV/Ang. 포논용이라 보통(-1E-2)보다 10배 빡빡
EDIFF  =  1E-08     ! 전자 SCF. EDIFFG 보다 충분히 아래여야 힘이 의미를 가진다

!---- 정밀도 --------------------------------------------------------
PREC    = Accurate  ! FFT 격자를 넉넉히. 힘/응력 정확도의 기본
ENCUT   = 600       ! POTCAR ENMAX 최대값(O: 400)의 1.5배. 전 strain 동일값 필수
ADDGRID = .TRUE.    ! 보조 FFT 격자. 힘의 egg-box 오차를 줄인다
LREAL   = .FALSE.   ! 실공간 투영 금지. 켜면 힘에 1 meV/Ang 급 오차가 섞인다
LASPH   = .TRUE.    ! 비구형 기울기 보정. Hf 5d 산화물에서 응력/힘에 유의미
ISYM    =   2       ! 대칭 유지. Pca2_1 을 완화 중에 깨뜨리지 않는다

!---- 전자구조 ------------------------------------------------------
ALGO   = Normal     ! Davidson. 절연체에서 안정적
NELM   = 200
NELMIN =   6        ! 이온 스텝마다 최소 6회. 셀이 움직일 때 과소수렴 방지
ISMEAR =   0        ! Gaussian smearing (넓은 갭 절연체)
SIGMA  = 0.01       ! 작게. 갭이 ~5.5 eV 라 엔트로피 항이 사실상 0
GGA    = PS         ! PBEsol.  !! 기존 POSCAR 를 만든 범함수와 반드시 일치시킬 것 !!

!---- 출력/병렬 -----------------------------------------------------
LWAVE  = .FALSE.
LCHARG = .FALSE.
! NCORE = 4         ! 노드 코어 수에 맞춰 조정 (sqrt(코어수) 근처가 무난)

!=====================================================================
! Pulay 응력 주의
!   평면파 바닥은 셀 부피에 따라 바뀌므로 셀을 움직이는 완화는 한 번에
!   수렴하지 않는다. **CONTCAR 를 POSCAR 로 복사해 같은 INCAR 로 2~3회
!   재시작**해서 셀 길이가 더 안 바뀔 때까지 돌릴 것.
!   ENCUT 600 이면 1회 재시작으로 보통 충분하다.
!=====================================================================
