SYSTEM = HfO2 Pca2_1  biaxial strain : finite-displacement forces (phonopy)

!=====================================================================
! 2단계. phonopy 유한변위 초격자의 힘 계산 (단일점, 완화 없음)
!
!   phonopy -d --dim="2 2 2" -c POSCAR     로 만든 POSCAR-0xx 각각에 대해
!   이 INCAR 로 **한 번씩** 돌린 뒤
!   phonopy -f disp-*/vasprun.xml          로 FORCE_SETS 를 만든다.
!
! 이 계산의 유일한 산출물은 **힘**이다. 에너지는 쓰지 않는다.
! 따라서 힘의 수치잡음을 끝까지 눌러야 한다.
!=====================================================================

!---- 완화 금지 -----------------------------------------------------
IBRION = -1         ! 이온을 움직이지 않는다. 변위는 POSCAR 에 이미 들어 있다
NSW    =  0         ! 이온 단계 0. (IBRION=-1 과 둘 다 명시하는 것이 안전)

!---- 힘 정확도 -----------------------------------------------------
EDIFF   = 1E-08     ! phonopy 표준. 힘이 ~1e-4 eV/Ang 수준으로 안정된다
PREC    = Accurate
ENCUT   = 600       ! INCAR_strain 과 **반드시 같은 값**. 다르면 변형 계열이 어긋난다
ADDGRID = .TRUE.    ! 보조 FFT 격자 -> 변위에 대한 힘의 매끄러움 개선
LREAL   = .FALSE.   ! 초격자가 커도 절대 .AUTO. 로 바꾸지 말 것. 힘이 오염된다
LASPH   = .TRUE.

!---- 대칭 끄기 (중요) ----------------------------------------------
ISYM = 0
!   변위된 초격자는 모체보다 대칭이 낮다. VASP 가 모체 대칭으로 힘을
!   대칭화하면 변위가 깨뜨린 성분이 0 으로 지워져 힘상수가 틀어진다.
!   phonopy 가 어차피 대칭화를 따로 하므로 여기서는 끄는 쪽이 안전하다.
!   (비용은 늘지만 2x2x2 = 96원자에서는 감당 가능하다)

!---- 전자구조 ------------------------------------------------------
ALGO   = Normal
NELM   = 200
NELMIN =   6
ISMEAR =   0
SIGMA  = 0.01
GGA    = PS         ! INCAR_strain 과 동일해야 한다

!---- 출력/병렬 -----------------------------------------------------
LWAVE  = .FALSE.
LCHARG = .FALSE.
! NCORE = 4         ! 96원자 초격자라 여기서 성능이 갈린다. 노드에 맞춰 조정

!=====================================================================
! k점 주의
!   2x2x2 초격자이므로 단위포의 1/2 밀도면 같은 샘플링이다.
!   단위포 6x6x6  ->  초격자 3x3x3  (make_biaxial_vasp.py 가 맞춰 써 준다)
!   초격자에서 k 를 과하게 줄이면 LO-TO 이전의 단거리 힘상수부터 틀어진다.
!=====================================================================
