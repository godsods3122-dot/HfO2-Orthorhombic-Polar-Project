SYSTEM = HfO2 Pca2_1  biaxial strain : Born effective charges + dielectric tensor

!=====================================================================
! 3단계. Born 유효전하 Z* 와 고주파 유전텐서 eps_inf (DFPT)
!
!   **단위포**에서 돌린다 (초격자 아님). phonopy 가 읽는 POSCAR 와 같은 셀.
!   1단계에서 완화된 CONTCAR 를 POSCAR 로 써야 한다.
!   끝나면:  phonopy-vasp-born  >  BORN
!
! 이 프로젝트에서 이 값이 왜 중요한가:
!   유전상수의 75~80% 가 격자(이온) 기여다 (results/chiral_phonon/SUMMARY.md 7.1).
!   Z* 가 틀리면 LO-TO 가 통째로 틀리고, Weyl 노드 위치까지 움직인다.
!=====================================================================

!---- DFPT ----------------------------------------------------------
LEPSILON = .TRUE.   ! 밀도범함수 섭동이론으로 Z*, eps_inf, 압전텐서를 계산
LRPA     = .FALSE.  ! 국소장 효과를 DFT 수준까지 포함. .TRUE. 면 eps_inf 가 과대평가
IBRION   = -1       ! 이온 완화 없음 (LEPSILON 이 자체 섭동 계산을 수행)
NSW      =  0

!---- 정밀도 --------------------------------------------------------
EDIFF   = 1E-08     ! 섭동 계산은 바닥상태 수렴에 민감하다. 느슨하면 Z* 합 규칙이 깨진다
PREC    = Accurate
ENCUT   = 600       ! 다른 두 INCAR 와 동일
ADDGRID = .TRUE.
LREAL   = .FALSE.
LASPH   = .TRUE.
ISYM    =  2        ! 대칭 유지. Z* 의 대칭 동치 원자들이 정확히 같은 값으로 나온다

!---- 전자구조 ------------------------------------------------------
ALGO   = Normal
NELM   = 200
NELMIN =   6
ISMEAR =   0
SIGMA  = 0.01
GGA    = PS         ! 다른 두 INCAR 와 동일

!---- 출력 ----------------------------------------------------------
LWAVE  = .FALSE.
LCHARG = .FALSE.

!=====================================================================
! 함정 두 가지
!
! 1) LEPSILON 은 NPAR 과 함께 쓸 수 없다.
!    NPAR 을 쓰면 VASP 가 경고를 내고 결과가 틀린다. **NPAR 을 쓰지 말 것.**
!    NCORE 도 여기서는 빼는 쪽이 안전하다 (NCORE 는 NPAR 로 환산된다).
!
! 2) eps_inf 는 k점에 느리게 수렴한다.
!    완화/힘 계산보다 조밀한 메시를 쓴다 (스크립트 기본: 단위포 8x8x8).
!
! 검산: OUTCAR 의 BORN EFFECTIVE CHARGES 를 전 원자에 대해 더하면
!       음향 총합 규칙상 0 이어야 한다. 0.05 e 이상 벗어나면 ENCUT/k점을 올릴 것.
!       (scripts/input.py 가 이 합을 출력한다)
!=====================================================================
